[Unit]
Description=Verify and back up Weiji SQLite to S3
Wants=network-online.target
After=network-online.target weiji.service

[Service]
Type=oneshot
User=weiji-backup
Group=weiji
WorkingDirectory=/opt/weiji
EnvironmentFile=/etc/weiji/backup.env
ExecStart=/usr/bin/node --experimental-sqlite scripts/backup-r2.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=yes
ProtectSystem=strict
