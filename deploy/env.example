# /etc/weiji/server.env
AUTH_MODE=oauth
HOST=127.0.0.1
TRUST_PROXY=1
PORT=5173
PUBLIC_ORIGIN=https://weiji.example.com
SQLITE_PATH=/var/lib/weiji/weiji.db
EMBEDDING_CACHE_DIR=/var/lib/weiji/models
GITHUB_CLIENT_ID=example-github-client-id
GITHUB_CLIENT_SECRET=replace-me
# GOOGLE_CLIENT_ID=example-google-client-id
# GOOGLE_CLIENT_SECRET=replace-me
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4

# /etc/weiji/backup.env (also copy SQLITE_PATH)
BACKUP_S3_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=weiji-backup
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=replace-me
BACKUP_S3_SECRET_ACCESS_KEY=replace-me
BACKUP_S3_PREFIX=weiji/
BACKUP_RETENTION_DAYS=30
