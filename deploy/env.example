# /etc/weiji/app.env — copy only this section to the Web service
AUTH_MODE=oauth
HOST=127.0.0.1
TRUST_PROXY=1
PORT=5173
PUBLIC_ORIGIN=https://weiji.example.com
SQLITE_PATH=/var/lib/weiji/weiji.db
EMBEDDING_CACHE_DIR=/var/cache/weiji/models
GITHUB_CLIENT_ID=example-github-client-id
GITHUB_CLIENT_SECRET=replace-me
# GOOGLE_CLIENT_ID=example-google-client-id
# GOOGLE_CLIENT_SECRET=replace-me
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4

# Optional read-only Obsidian sync (COS virtual-hosted style)
# OBSIDIAN_S3_ENDPOINT=https://cos.ap-tokyo.myqcloud.com
# OBSIDIAN_S3_BUCKET=example-vault-1234567890
# OBSIDIAN_S3_REGION=ap-tokyo
# OBSIDIAN_S3_ACCESS_KEY_ID=replace-me
# OBSIDIAN_S3_SECRET_ACCESS_KEY=replace-me
# OBSIDIAN_S3_FORCE_PATH_STYLE=false
# OBSIDIAN_SYNC_PREFIXES=memo/,永久笔记/
# OBSIDIAN_ACCOUNT_ID=
# OBSIDIAN_SYNC_INTERVAL_MS=3600000
# OBSIDIAN_INDEX_RECOVERY_COOLDOWN_MS=60000

# /etc/weiji/backup.env — copy only this section and the same SQLITE_PATH
BACKUP_S3_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=weiji-backup
BACKUP_S3_REGION=auto
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_ACCESS_KEY_ID=replace-me
BACKUP_S3_SECRET_ACCESS_KEY=replace-me
BACKUP_S3_PREFIX=weiji/
BACKUP_RETENTION_DAYS=30
# BACKUP_VERIFY_UPLOADED=1

# COS alternative: replace the R2 endpoint, bucket, region, style and prefix above.
# BACKUP_S3_ENDPOINT=https://cos.ap-tokyo.myqcloud.com
# BACKUP_S3_BUCKET=example-vault-1234567890
# BACKUP_S3_REGION=ap-tokyo
# BACKUP_S3_FORCE_PATH_STYLE=false
# BACKUP_S3_PREFIX=_weiji-backup/
