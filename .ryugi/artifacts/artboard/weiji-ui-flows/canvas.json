    "t-ios-entry": {
      "kind": "title",
      "page": "ios-entry",
      "x": 0,
      "y": 0,
      "text": "iOS · 入口与笔记流",
      "description": "覆盖启动鉴权、笔记主页（多维独立筛选胶囊 / 搜索态不隐藏快记 / 顶栏统一设置齿轮）、实底侧栏抽屉、单层全宽图形日历 Sheet、统一设置页（外观+AI+连接+同步）与全屏 Zoom 精读编辑。"
    },
    "c-ios-auth": {
      "kind": "condition",
      "page": "ios-entry",
      "x": 882,
      "y": 1985,
      "text": "已登录？"
    },
    "s-entry-cross": {
      "kind": "sticky",
      "page": "ios-entry",
      "x": 3424,
      "y": 420,
      "w": 280,
      "text": "跨 Tab 循环：\n• 精读点「问 AI」→ 切 AI Tab（按上下文保草稿，在途流确认）\n• 精读点 #标签 → 切笔记 Tab 按标签筛选"
    },
    "t-ios-walk": {
      "kind": "title",
      "page": "ios-walk",
      "x": 0,
      "y": 0,
      "text": "iOS · 随机漫步流",
      "description": "语义引力图谱：顶栏左侧随时快记；点击焦点卡或长按关联卡查看全文、点击关联卡切换焦点并压入上一步栈、右上角「问 AI」（独立 pins 草稿槽 + 在途流保护）。"
    },
    "t-ios-ai": {
      "kind": "title",
      "page": "ios-ai",
      "x": 0,
      "y": 0,
      "text": "iOS · AI 对话流",
      "description": "按上下文固定 Key 保存/恢复草稿，在途流切换弹窗确认；模型胶囊始终打开 ModelPickerSheet（Codex 1 步直选）；顶栏齿轮直达统一设置页 AI 分区；AI 引用精读可加入或移出引用，不关闭页面。"
    },
    "s-ai-guard": {
      "kind": "sticky",
      "page": "ios-ai",
      "x": 2646,
      "y": 420,
      "w": 280,
      "text": "状态保护契约：\n• 切会话/跨 Tab 追问按固定 draftContextKey 保草稿\n• 流式生成中切换弹确认 Alert（取消则流继续）\n• AI 引用精读点「加入/移出引用」不关闭页面"
    },
    "t-ios-insights": {
      "kind": "title",
      "page": "ios-insights",
      "x": 0,
      "y": 0,
      "text": "iOS · 洞察与画像流",
      "description": "顶栏左侧随时快记 + 分段切换「洞察｜画像」；全链路改用原生 NavigationStack Push（画板 → 配方/历史 → 报告 → 引用精读），出栈后台继续生成且与查看历史报告完全解耦。"
    },
    "s-ins-bg": {
      "kind": "sticky",
      "page": "ios-insights",
      "x": 3528,
      "y": 420,
      "w": 280,
      "text": "后台生成与跨 Tab：\n• 离开生成中的报告不中止任务，回画板显示状态条并可随时看历史报告\n• 报告「继续追问」→ 走 AI 在途流保护切至 AI Tab"
    },
    "t-web": {
      "kind": "title",
      "page": "web-flows",
      "x": 0,
      "y": 0,
      "text": "Web · M3 桌面与移动流",
      "description": "4 个平级主工作区（笔记 / 随机漫步 / AI 对话 / AI 洞察[含个人画像]），去浮层 ✕ 关闭；漫步居于 .workspace 内且切走保留焦点与上一步；侧栏三分区 + 底部单一「导入笔记」入口。"
    },
    "t-tokens": {
      "kind": "title",
      "page": "tokens",
      "x": 0,
      "y": 0,
      "text": "设计规范 · Tokens 与明暗对照",
      "description": "双端统一的设计 Token 单一事实源（pages/tokens.css），自动校验 WCAG 对比度，并排展示浅色暖纸与深色炭灰实际渲染效果。"
    }
  },
