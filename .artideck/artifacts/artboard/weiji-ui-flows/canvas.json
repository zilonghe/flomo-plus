    "t-ios-entry": {
      "kind": "title",
      "page": "ios-entry",
      "x": 0,
      "y": 0,
      "text": "iOS · 入口与笔记流",
      "description": "覆盖启动鉴权、笔记主页（原生 TabView / .searchable / FAB）、实底侧栏抽屉、日历筛选、连接设置、快速记与全屏 Zoom 精读编辑。"
    },
    "c-ios-auth": {
      "kind": "condition",
      "page": "ios-entry",
      "x": 882,
      "y": 1985,
      "text": "已登录？"
    },
    "t-ios-walk": {
      "kind": "title",
      "page": "ios-walk",
      "x": 0,
      "y": 0,
      "text": "iOS · 随机漫步流",
      "description": "语义引力图谱：焦点卡轻点精读、长按关联卡精读、点击关联卡跃迁并压入上一跳栈、右上角一键带组聊 AI。"
    },
    "t-ios-ai": {
      "kind": "title",
      "page": "ios-ai",
      "x": 0,
      "y": 0,
      "text": "iOS · AI 对话流",
      "description": "以空态/对话态为核心，向外连接历史会话抽屉、@ 置顶引用、模型选择、AI 设置短 Sheet 及引用笔记精读回跳。"
    },
    "t-ios-insights": {
      "kind": "title",
      "page": "ios-insights",
      "x": 0,
      "y": 0,
      "text": "iOS · 洞察与画像流",
      "description": "顶栏原生分段切换「洞察｜画像」；配方画板支持选视角配置范围 → 生成报告 → Push 精读引用，以及历史报告与自定义视角。"
    },
    "t-web": {
      "kind": "title",
      "page": "web-flows",
      "x": 0,
      "y": 0,
      "text": "Web · M3 桌面与移动流",
      "description": "Material Design 3 暖纸浅色与炭灰深色系统：独立登录页、桌面笔记主界面、详情/导入弹窗、漫步/AI/洞察工作区及 375px 48px 热区适配。"
    },
    "t-tokens": {
      "kind": "title",
      "page": "tokens",
      "x": 0,
      "y": 0,
      "text": "设计规范 · Tokens 与明暗对照",
      "description": "双端统一的设计 Token 单一事实源（pages/tokens.css），自动校验 WCAG 对比度，并排展示浅色暖纸与深色炭灰实际渲染效果。"
    }
